[Unit]
Description=Pi Remote PWA private Tailnet gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/src/pi-remote-pwa
ExecStart=/ABSOLUTE/PATH/TO/node %h/src/pi-remote-pwa/pwa/server.mjs
Environment=PATH=/ABSOLUTE/NODE/BIN:%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
Environment=PI_REMOTE_PWA_PI_COMMAND=/ABSOLUTE/PATH/TO/pi
Environment=PI_REMOTE_PWA_BIND=127.0.0.1
Environment=PI_REMOTE_PWA_PORT=8792
Environment=PI_CODING_AGENT_SESSION_DIR=%h/.local/state/pi-remote-pwa/sessions
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
