#!/usr/bin/env node
import { createInterface } from "node:readline";
import path from 'node:path';
import {randomUUID} from 'node:crypto';
import {readFileSync} from 'node:fs';
const args=process.argv;
const root=args[args.indexOf('--session-dir')+1]||'/tmp';
const fileArg=args.indexOf('--session');
let file=fileArg>=0?args[fileArg+1]:path.join(root,'empty.jsonl');
let sessionId='session_test_12345';try{sessionId=JSON.parse(readFileSync(file,'utf8').split('\n')[0]).id;}catch{}
let sessionName;let level='low';
let model={provider:'mock',id:'test',name:'Test model',reasoning:true,input:['text','image'],contextWindow:200000,headers:{Authorization:'NEVER_SEND_SECRET'},baseUrl:'https://private.invalid?key=SECRET'};
const models=[model,{...model,id:'other',name:'Other model'}];
let messages;try{messages=readFileSync(file,'utf8').split('\n').filter(Boolean).map(line=>JSON.parse(line)).filter(v=>v.type==='message').map(v=>v.message);}catch{}
messages ||= [{role:'user',content:[{type:'text',text:'hello'}]}];
const output = event => process.stdout.write(JSON.stringify(event) + "\n");
const lines = createInterface({ input: process.stdin, crlfDelay: Infinity });
for await (const line of lines) {
  let command;
  try { command = JSON.parse(line); } catch { continue; }
  const { id, type } = command;
  if (type === "get_state") {
    output({ type: "response", id, command: type, success: true, data: {sessionId,sessionFile:file,sessionName,model,thinkingLevel:level,isStreaming:false} });
  } else if (type === 'new_session') {
    sessionId=randomUUID();file=path.join(root,sessionId+'.jsonl');messages.length=0;
    output({type:'response',id,command:type,success:true,data:{cancelled:false}});
  } else if(type==='set_session_name') {sessionName=command.name;output({type:'response',id,command:type,success:true});
  } else if(type==='set_model') {model=models.find(m=>m.provider===command.provider&&m.id===command.modelId);output({type:'response',id,command:type,success:!!model,data:model});
  } else if(type==='set_thinking_level') {level=command.level;output({type:'response',id,command:type,success:true});
  } else if(type==='get_available_models') {output({type:'response',id,command:type,success:true,data:{models}});
  } else if(type==='get_available_thinking_levels') {output({type:'response',id,command:type,success:true,data:{levels:['off','low','high']}});
  } else if(type==='get_commands') {output({type:'response',id,command:type,success:true,data:{commands:[{name:'test-command',description:'Test extension',source:'extension',sourceInfo:{path:'/secret'}}]}});
  } else if(type==='get_session_stats') {output({type:'response',id,command:type,success:true,data:{sessionId,sessionFile:file,contextUsage:{percent:5,tokens:10000,contextWindow:200000}}});
  } else if (type === "get_messages") {
    output({ type: "response", id, command: type, success: true, data: { messages } });
  } else if(type==='extension_ui_response') {
    messages.push({role:'custom',customType:'browser-interaction-result',content:command.cancelled?'cancelled':String(command.confirmed ?? command.value)});
    output({type:'message_end'});
  } else if (type === "prompt") {
    messages.push({ role: "user", content: [{ type: "text", text: command.message },...(command.images||[])] });
    output({ type: "response", id, command: type, success: true });
    if(command.message==='/test-command') {output({type:'extension_ui_request',id:'browser-request-0001',method:'confirm',title:'Browser test approval',message:'Choose explicitly'});continue;}
    output({ type: "agent_start" });
    setTimeout(() => {
      output({ type: "message_update", assistantMessageEvent: { type: "text_delta", delta: "mock reply" } });
      messages.push({ role: "assistant", content: [{ type: "text", text: "mock reply" }] });
      output({ type: "message_end" });
      output({ type: "turn_end" });
      output({ type: "agent_end" });
    }, 40);
  } else if (type === "abort") {
    output({ type: "response", id, command: type, success: true });
  } else {
    output({ type: "response", id, command: type, success: false, error: "unsupported test command" });
  }
}
