{
  "name": "@pi-remote/host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "pair": "node dist/pair-cli.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "pair:dev": "tsx src/pair-cli.ts"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "tsx": "^4.20.6",
    "qrcode-terminal": "^0.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/qrcode": "^1.5.5"
  }
}
